{
  "name": "cerahujan",
  "private": true,
  "version": "0.1.0",
  "description": "Weather, heat, storms and haze for Malaysia on a 3D map. Free, bilingual (BM/EN).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler pages dev",
