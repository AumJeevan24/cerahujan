# Cerahujan — local settings
# Copy this file to ".env" and fill in your values. ".env" is never committed.

# NASA FIRMS key for fire hotspots (server only — never shown in the browser).
# Get one free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional: WAQI token for air-quality station readings (public, shows in browser).
# Get one free at: https://aqicn.org/data-platform/token/
VITE_WAQI_TOKEN=

# Optional: Cloudflare Web Analytics beacon token (public, cookieless analytics).
# Cloudflare dashboard -> Analytics & Logs -> Web Analytics -> Add a site.
VITE_CF_BEACON_TOKEN=
